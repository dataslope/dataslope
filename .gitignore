# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example


# OpenNext Cloudflare adapter: build output (regenerated by `cf:deploy`),
# Wrangler's local state/cache, and the local `wrangler dev`/preview vars file.
/.open-next/
/.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts
script-runner-src/bin/
script-runner-src/obj/
script-runner-src/__pycache__/

# fumadocs-mdx generated source (rebuilt on every build/dev start)
.source/

# Pre-bundled almostnode JS/TS workers (rebuilt by
# `scripts/build-almostnode-workers.mjs` on postinstall + build + dev).
/public/_workers/

# Static data behind /svg-gallery (rebuilt by
# `scripts/build-svg-gallery-data.mjs` on build + dev).
/public/svg-gallery/

# Raw-Markdown mirrors of the course lessons (rebuilt by
# `scripts/build-course-md.mjs` on build + dev; served as static assets at
# `/courses/<lesson>.md`).
/public/courses/

# Search corpus and the D1 seed built from it (rebuilt by
# `scripts/build-search-corpus.mjs` + `build-search-sql.mjs` on postinstall +
# build + dev). Neither is served or bundled: the corpus is an intermediate,
# and the SQL is applied to D1 at deploy time.
/lib/generated/search-corpus.json
/lib/generated/search-seed.sql

# Mermaid's brand-token fallback map, parsed from app/brand.css (rebuilt by
# `scripts/build-brand-fallbacks.mjs` on postinstall + build + dev). The
# committed `.d.ts` sibling is kept so typecheck/lint pass before it exists.
/lib/generated/brand-fallbacks.js
/lib/generated/course-catalog.js
/lib/generated/home-stats.js
/lib/generated/charts.js
/lib/generated/created-at.js

# Playground audit output (e2e/playground-audit.spec.ts)
audit-results/

# GPT Image 2 output from scripts/generate-illustrations.mjs
generated-illustrations/

# Local chart preview harness (.cp.mjs renders charts/*.mjs to PNGs in both
# themes so a spec can be eyeballed without running the site)
/.cp.mjs
/.cp.html
/.cp/

# Datasets cached by scripts/check-code-blocks.mjs
/.dataset-cache/
