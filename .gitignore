# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# OpenNext Cloudflare adapter: build output (regenerated by `cf:deploy`),
# Wrangler's local state/cache, and the local `wrangler dev`/preview vars file.
/.open-next/
/.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts
script-runner-src/bin/
script-runner-src/obj/
script-runner-src/__pycache__/

# fumadocs-mdx generated source (rebuilt on every build/dev start)
.source/

# Pre-bundled almostnode JS/TS workers (rebuilt by
# `scripts/build-almostnode-workers.mjs` on postinstall + build + dev).
/public/_workers/

# Static data behind /svg-gallery (rebuilt by
# `scripts/build-svg-gallery-data.mjs` on build + dev).
/public/svg-gallery/

# Server-side search index, bundled into the Worker (rebuilt by
# `scripts/build-search-index.mjs` on postinstall + build + dev). The
# committed `.d.ts` sibling is kept so typecheck/lint pass before it exists.
/lib/generated/search-index.js

# Output of scripts/check-mermaid-errors.mjs (regenerated on demand).
/mermaid-check-results.json

# Playground audit output (e2e/playground-audit.spec.ts)
audit-results/
