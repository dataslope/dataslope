{
  "mcpServers": {
    "mermaid": {
      "type": "http",
      "url": "https://mcp.mermaid.ai/mcp"
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "duckdb": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", ":memory:"]
    }
  }
}
