{
  // Workers config for the DataSlope Next.js app, deployed via the OpenNext
  // adapter (`npm run cf:deploy`). This is the APP worker; the standalone
  // CORS proxy has its own config under cloudflare-cors-proxy/wrangler.toml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dataslope",
  "compatibility_date": "2025-05-19",
  // `nodejs_compat` is required by OpenNext; `global_fetch_strictly_public`
  // sends the worker's own fetch() over the public internet instead of
  // looping back into the worker (OpenNext-recommended).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // /_next/static/* and public/ are served by this binding before the worker
  // runs: free, unmetered, CDN-cached. Prerendered page HTML is NOT here —
  // OpenNext writes it to the R2 incremental cache below, and the worker runs
  // ahead of the CDN cache, so every page view costs one worker invocation.
  // `withRegionalCache` (open-next.config.ts) avoids a per-visitor R2 read;
  // skipping the invocation itself needs an origin Cache Rule (see README.md).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backing store for OpenNext's incremental cache (see open-next.config.ts):
  // prerendered pages are written at deploy time and served from here, so the
  // Worker never re-renders (and never touches `node:fs`). Resolves on
  // preview deployments too, unlike the static-assets cache. Binding name is
  // fixed by OpenNext. Create once:
  // `npx wrangler r2 bucket create dataslope-inc-cache`.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "dataslope-inc-cache" },
    // Cloud-saved playground workspaces + shared snapshots (gzipped JSON
    // bundles; lib/workspaces/bundle.ts). D1 holds only metadata rows —
    // payloads routinely exceed D1's 2 MB row cap, and R2 reads are
    // egress-free. Create once:
    // `npx wrangler r2 bucket create dataslope-workspaces`.
    { "binding": "WORKSPACES_BUCKET", "bucket_name": "dataslope-workspaces" }
  ],
  // D1 backing Better Auth accounts/sessions; `DB` is read by
  // lib/auth/server.ts. Schema in migrations/auth/, applied with
  // `npx wrangler d1 migrations apply dataslope-auth [--remote]`. Create once
  // with `npx wrangler d1 create dataslope-auth` and paste the printed
  // `database_id` below (not a secret).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dataslope-auth",
      "database_id": "827500a4-7853-4da0-98dd-70ffe6473d41",
      "migrations_dir": "migrations/auth"
    },
    // Illustration review state (admin regeneration marks + prompt guidance).
    // Deliberately NOT in dataslope-auth: authoring data, so an agent can
    // wipe the queue without touching accounts or sessions. Schema in
    // migrations/illustrations/.
    {
      "binding": "ILLUSTRATIONS_DB",
      "database_name": "dataslope-illustrations",
      "database_id": "0ab9f248-58dc-4e0a-a17e-f41badf9f6c0",
      "migrations_dir": "migrations/illustrations"
    },
    // Lesson full-text search index (/api/search). Its own database on
    // purpose: it holds the only FTS5 virtual table, and `wrangler d1 export`
    // refuses databases containing one (a failed attempt can wedge the DB,
    // cloudflare/workers-sdk#9519). Rows are derived from content/ and
    // re-seeded each deploy, so that's harmless here — but don't move auth or
    // illustration data (not rebuildable) into it. Schema in
    // migrations/search/ (`npm run db:migrate:search[:remote]`); rows via
    // `npm run db:seed:search[:remote]`.
    {
      "binding": "SEARCH_DB",
      "database_name": "dataslope-search",
      "database_id": "ce381a06-35af-4279-ab9e-f33013751c95",
      "migrations_dir": "migrations/search"
    }
  ],
  // Non-secret auth config; OAuth client secrets and BETTER_AUTH_SECRET are
  // set via `npx wrangler secret put <NAME>` (see README). BETTER_AUTH_URL
  // must be the deployed origin so OAuth callbacks resolve.
  "vars": {
    "BETTER_AUTH_URL": "https://dataslope.com",
    // Must be a Resend-verified domain. RESEND_API_KEY is a secret; email
    // verification and password reset stay off until it's set.
    "EMAIL_FROM": "Dataslope <no-reply@dataslope.com>",
    // "Ask AI" + inline-completion model selection (non-secret). No hardcoded
    // fallback (lib/ai/models.ts) — change model ids here without a code
    // change. Keys are secrets: AI_FREE_API_KEY covers both tiers via
    // resolveModel's fallback (add AI_PRO_API_KEY for a separate pro key).
    // Ask AI stays inert (503) until a tier has key + base URL + model set;
    // inline completion (pro members only) uses the pro-tier config.
    "AI_FREE_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_FREE_MODEL": "deepseek/deepseek-v4-flash",
    "AI_PRO_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_PRO_MODEL": "deepseek/deepseek-v4-flash",
    // Polar billing for Pro (non-secret half; lib/billing/polar.ts + README).
    // Inert until POLAR_PRO_PRODUCT_ID and the POLAR_ACCESS_TOKEN secret are
    // set; the webhook also needs the POLAR_WEBHOOK_SECRET secret.
    // POLAR_SERVER="sandbox" targets sandbox.polar.sh.
    "POLAR_PRO_PRODUCT_ID": "",
    "POLAR_PRO_ANNUAL_PRODUCT_ID": "",
    "POLAR_SERVER": ""
  },
  // Lets the worker invoke itself (used by OpenNext for cache/revalidation
  // plumbing). Must match "name" above.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "dataslope" }
  ],
  // Workers Logs (queryable in the dashboard). `invocation_logs` off to avoid
  // a per-request summary line — the main driver of log-event volume/cost.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
