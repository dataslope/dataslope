{
  // Cloudflare Workers configuration for the DataSlope Next.js app, deployed
  // via the OpenNext adapter (@opennextjs/cloudflare). `npm run cf:deploy`
  // builds `.open-next/` (which runs the full `npm run build` chain) and then
  // `wrangler deploy` ships the worker + static assets described here.
  //
  // This is the APP worker. The standalone CORS proxy worker has its own
  // config under cloudflare-cors-proxy/wrangler.toml, don't conflate them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dataslope",
  "compatibility_date": "2025-05-19",
  // `nodejs_compat` is required by OpenNext (Fumadocs/Orama search and the
  // build-time node:fs reads expect Node APIs). `global_fetch_strictly_public`
  // makes the worker's own fetch() calls go out over the public internet
  // rather than looping back into the worker, the OpenNext-recommended flag.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Prerendered pages and /_next/static/* are uploaded as free static assets
  // (unlimited bandwidth, no per-request meter) and served before the worker
  // ever runs. This is what removes the Vercel ISR-read meter.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backing store for OpenNext's incremental cache (see open-next.config.ts).
  // The prerendered home page and ~800 `/courses/*` lessons are written here at
  // deploy time (the `opennextjs-cloudflare deploy`/`preview` populate step)
  // and served from here at request time, so the Worker never re-renders them
  // and never touches `node:fs`. Unlike the static-assets cache this resolves
  // on preview deployments too, so Workers Builds preview URLs stop 500ing.
  // Binding name is fixed by OpenNext: `NEXT_INC_CACHE_R2_BUCKET`. Create the
  // bucket once with: `npx wrangler r2 bucket create dataslope-inc-cache`.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "dataslope-inc-cache" },
    // Cloud-saved playground workspaces + shared playground snapshots (the
    // gzipped JSON bundles; see lib/workspaces/bundle.ts). D1 holds only the
    // metadata rows (migrations/0005), the payload bytes live here because
    // SQL dumps and file sets routinely exceed D1's 2 MB row cap, and R2
    // reads are egress-free. Create the bucket once with:
    // `npx wrangler r2 bucket create dataslope-workspaces`.
    { "binding": "WORKSPACES_BUCKET", "bucket_name": "dataslope-workspaces" }
  ],
  // D1 (edge SQLite) backing user accounts and sessions for Better Auth, the
  // accounts layer from agent-outputs/20260621-1733-…-auth-membership-….md (Q1).
  // The binding name `DB` is what lib/auth/server.ts reads via
  // getCloudflareContext().env.DB. The schema lives in migrations/ and is applied
  // with `npx wrangler d1 migrations apply dataslope-auth [--remote]`.
  // Create the database once with: `npx wrangler d1 create dataslope-auth`
  // and paste the printed `database_id` below (it is not a secret).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dataslope-auth",
      "database_id": "827500a4-7853-4da0-98dd-70ffe6473d41",
      "migrations_dir": "migrations"
    },
    // Illustration review state: which generated images an admin marked for
    // regeneration and the extra prompt guidance to redraw them with, written
    // from /illustration-prompts via /api/admin/illustration-marks. Deliberately
    // NOT in dataslope-auth: this is authoring data, so a coding agent can read
    // and wipe the whole queue without touching accounts or sessions. Schema in
    // migrations-illustrations/, applied with
    // `npx wrangler d1 migrations apply dataslope-illustrations [--remote]`.
    // Created once with: `npx wrangler d1 create dataslope-illustrations`.
    {
      "binding": "ILLUSTRATIONS_DB",
      "database_name": "dataslope-illustrations",
      "database_id": "0ab9f248-58dc-4e0a-a17e-f41badf9f6c0",
      "migrations_dir": "migrations-illustrations"
    }
  ],
  // Non-secret auth config. The OAuth client secrets and BETTER_AUTH_SECRET are
  // NOT here, set them with `npx wrangler secret put <NAME>` (see README).
  // BETTER_AUTH_URL must be the deployed origin so OAuth callbacks resolve; it
  // defaults to the request origin when unset, so it's only strictly needed if
  // that ever differs from the canonical site URL.
  "vars": {
    "BETTER_AUTH_URL": "https://dataslope.com",
    // From address for transactional auth email (must be a Resend-verified
    // domain). The RESEND_API_KEY itself is a secret, set it with
    // `npx wrangler secret put RESEND_API_KEY` (see README). Email verification
    // and password reset stay off until that key is set.
    "EMAIL_FROM": "Dataslope <no-reply@dataslope.com>",
    // "Ask AI" + AI inline completion model selection (non-secret). Both
    // tiers currently point at OpenRouter's DeepSeek V4 Flash model. There's
    // no hardcoded fallback (see lib/ai/models.ts), change the model ids
    // here without a code change. The API key is a secret: set it with
    // `npx wrangler secret put AI_FREE_API_KEY` (one OpenRouter key covers
    // both tiers via resolveModel's fallback; add AI_PRO_API_KEY too if pro
    // should use a separate key later). Ask AI stays inert (503) until a
    // tier has its key + base URL + model all set. AI inline completion
    // (app/api/ai/complete, pro members only) uses the pro-tier config.
    "AI_FREE_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_FREE_MODEL": "deepseek/deepseek-v4-flash",
    "AI_PRO_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_PRO_MODEL": "deepseek/deepseek-v4-flash",
    // Polar billing for Pro subscriptions (non-secret half; see
    // lib/billing/polar.ts + README "Pro subscriptions"). Billing stays
    // inert until POLAR_PRO_PRODUCT_ID (the Polar product that grants Pro)
    // and the POLAR_ACCESS_TOKEN secret are set; the webhook endpoint also
    // needs `wrangler secret put POLAR_WEBHOOK_SECRET`. Set POLAR_SERVER to
    // "sandbox" to test against sandbox.polar.sh.
    "POLAR_PRO_PRODUCT_ID": "",
    "POLAR_PRO_ANNUAL_PRODUCT_ID": "",
    "POLAR_SERVER": ""
  },
  // Lets the worker invoke itself (used by OpenNext for cache/revalidation
  // plumbing). Must match "name" above.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "dataslope" }
  ],
  // Workers Logs: persists console/log output and request metadata for this
  // worker so it's queryable in the Cloudflare dashboard (Observability).
  // `invocation_logs` is disabled to avoid a per-request summary log line
  // (the main driver of log-event volume/cost).
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
