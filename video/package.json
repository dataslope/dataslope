{
  "name": "dataslope-video",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic tutorial videos for Dataslope, rendered with Remotion.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "still": "remotion still --scale=2",
    "render": "remotion render --scale=2",
    "render:preview": "remotion render --scale=0.5",
    "patterns": "node scripts/render-patterns.mjs",
    "illustrations": "node scripts/illustrations.mjs",
    "cues": "node scripts/cues.mjs",
    "test": "node --test src/narration/timeline.test.ts",
    "render:fhd": "remotion render --scale=1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.2",
    "eslint": "9.39.5",
    "playwright-core": "1.62.1",
    "tabbied": "0.10.0",
    "typescript": "5.9.3"
  }
}
