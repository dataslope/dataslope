    "where": "SELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nLEFT JOIN orders o\n  ON o.customer_id = c.id\nWHERE o.amount > 50\nORDER BY c.name, o.id;",
    "on": "SELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nLEFT JOIN orders o\n  ON o.customer_id = c.id\n  AND o.amount > 50\nORDER BY c.name, o.id;",
    "inner": "SELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nJOIN orders o\n  ON o.customer_id = c.id\nWHERE o.amount > 50\nORDER BY c.name, o.id;",
