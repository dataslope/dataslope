{
  "name": "dataslope",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "fumadocs-mdx && node scripts/build-almostnode-workers.mjs && node scripts/build-search-index.mjs && node scripts/build-course-md.mjs && node scripts/build-brand-fallbacks.mjs && node scripts/build-charts.mjs && node scripts/build-created-at.mjs && node scripts/build-course-catalog.mjs && node scripts/build-home-stats.mjs && node scripts/build-images.mjs && next dev",
    "build": "fumadocs-mdx && node scripts/build-almostnode-workers.mjs && node scripts/build-search-index.mjs && node scripts/build-course-md.mjs && node scripts/build-brand-fallbacks.mjs && node scripts/build-charts.mjs && node scripts/build-created-at.mjs && node scripts/build-course-catalog.mjs && node scripts/build-home-stats.mjs && node scripts/build-images.mjs && next build",
    "build:workers": "node scripts/build-almostnode-workers.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "build:course-md": "node scripts/build-course-md.mjs",
    "build:brand-fallbacks": "node scripts/build-brand-fallbacks.mjs",
    "build:charts": "node scripts/build-charts.mjs",
    "build:created-at": "node scripts/build-created-at.mjs",
    "build:course-catalog": "node scripts/build-course-catalog.mjs",
    "build:home-stats": "node scripts/build-home-stats.mjs",
    "build:images": "node scripts/build-images.mjs",
    "build:og-image": "node scripts/build-og-image.mjs",
    "publish:tools-jar": "npm publish ./tools-jar",
    "postinstall": "node scripts/patch-almostnode.mjs && node scripts/postinstall-generate.mjs",
    "start": "next start",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv .wrangler/types.d.ts",
    "db:migrate": "wrangler d1 migrations apply dataslope-auth",
    "db:migrate:remote": "wrangler d1 migrations apply dataslope-auth --remote",
    "db:migrate:illustrations": "wrangler d1 migrations apply dataslope-illustrations",
    "db:migrate:illustrations:remote": "wrangler d1 migrations apply dataslope-illustrations --remote",
    "lint": "eslint .",
    "check:challenges": "node scripts/check-challenge-cards.mjs",
    "check:code-blocks": "node scripts/check-code-blocks.mjs",
    "check:mcq": "node scripts/check-mcq.mjs",
    "check:mdx": "node scripts/check-mdx-blocks.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:solutions": "playwright test e2e/challenge-solutions.spec.ts"
  },
